# Copy to .env.local and fill in. Never commit real values.
# Local Supabase (`npm run db:start`) prints these; for a hosted project find
# them under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: public URL of the site, used for magic-link redirects.
# Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
